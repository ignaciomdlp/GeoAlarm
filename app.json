{
  "expo": {
    "name": "GeoAlarm",
    "slug": "place-o-clock",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.geoalarm.app",
      "infoPlist": {
        "UIBackgroundModes": [
          "location",
          "audio",
          "fetch"
        ],
        "NSLocationWhenInUseUsageDescription": "GeoAlarm necesita tu ubicación para calcular la distancia a tu parada de transporte.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "GeoAlarm monitorea en segundo plano tu distancia al destino para hacer sonar la alarma incluso si la app está cerrada o la pantalla bloqueada."
      }
    },
    "android": {
      "package": "com.geoalarm.app",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "POST_NOTIFICATIONS",
        "WAKE_LOCK",
        "VIBRATE",
        "REQUEST_IGNORE_BATTERY_OPTIMIZATIONS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "GeoAlarm requiere monitoreo continuo de geolocalización para avisarte antes de llegar a tu destino.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "expo-font",
      "expo-status-bar",
      "expo-audio",
      "expo-asset",
      [
        "expo-notifications",
        {
          "color": "#7E22CE"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "b1897e46-cfdf-4389-9550-d97747db0376"
      }
    }
  }
}
