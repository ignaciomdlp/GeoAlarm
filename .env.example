EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
EXPO_PUBLIC_NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# Clave API para CARTO Basemaps (Opcional)
# Si no se define una clave, la app utiliza automáticamente OpenStreetMap libre sin marcas de agua.
# Si tienes una API Key de CARTO (https://carto.com/basemaps), colócala aquí:
EXPO_PUBLIC_CARTO_API_KEY=
